# Öffentliche Adresse (für die Google-Redirect-URI und die Origin-Prüfung)
PUBLIC_BASE_URL=https://buntu-1.tail8569e8.ts.net

# Google-Login (Google Cloud Console > APIs & Dienste > Anmeldedaten > OAuth-Client "Webanwendung")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Diese Adressen sind beim ersten Google-Login sofort aktive Admins (kommagetrennt)
ADMIN_EMAILS=

# Verantwortlicher für die Datenschutzerklärung unter /datenschutz (Google verlangt sie)
CONTACT_NAME=
CONTACT_EMAIL=
# CONTACT_ADDRESS=

# Notfall-Admin mit Passwort. In Produktion nur aktiv, wenn das Passwort mindestens 16 Zeichen hat.
APP_USER=admin@admin.com
APP_PASSWORD=
# LOCAL_LOGIN=0 schaltet den Passwort-Login ganz ab
# LOCAL_LOGIN=1

# optional fester Schlüssel für das kurzlebige OAuth-Cookie; ohne Angabe wird einer in data/.secret erzeugt
# SECRET_KEY=
# optional andere Datenbank (Standard: SQLite in data/app.db)
# DATABASE_URL=
